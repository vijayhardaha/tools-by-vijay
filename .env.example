# ============================================================================
# Environment Variables — copy this file to `.env.local` to use locally
# ============================================================================

# ----------------------------------------------------------------------------
# Upstash Redis / Vercel KV — OPTIONAL (used only for API rate limiting)
# ----------------------------------------------------------------------------
# Either pair works: the code prefers the UPSTASH_* pair and falls back to the
# KV_* pair. On Vercel, link "Storage → KV (Upstash Redis)" in the dashboard
# and these are injected automatically (you can ignore this file).
#
# If neither pair is set, rate limiting fails open (all requests are allowed).
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV fallback variable names (used only if the UPSTASH_* pair is absent)
KV_REST_API_URL=
KV_REST_API_TOKEN=