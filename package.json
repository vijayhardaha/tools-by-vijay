{
  "name": "tools-by-vijay",
  "version": "0.1.0",
  "description": "A collection of free online tools built to make developer’s lives easier. From code optimization to text transformation, find the tools you need for your projects.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack && next-sitemap --config next-sitemap.config.js",
    "build:llms": "bun scripts/build-llms-txt.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check --log-level error .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "type": "module",
  "author": {
    "name": "Vijay Hardaha",
